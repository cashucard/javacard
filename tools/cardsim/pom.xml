<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>me.flashapp.cashu</groupId>
    <artifactId>cardsim</artifactId>
    <version>2.0.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>Cashu JavaCard simulator bridge</name>
    <description>
        The real CashuApplet inside jCardSim, served over loopback HTTP so an
        app's fake NFC transport can talk to a card without a reader. See the
        header of CardSim.java for the API.
    </description>
    <url>https://github.com/cashucard/javacard</url>

    <properties>
        <maven.compiler.release>11</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Pinned to applet/pom.xml: the applet must compile and behave here
             exactly as it does in its own suite. -->
        <jcardsim.version>3.0.6.0</jcardsim.version>
        <junit.version>5.10.1</junit.version>
        <gson.version>2.11.0</gson.version>
    </properties>

    <dependencies>
        <!-- Same fork and version as applet/pom.xml; see the note there. -->
        <dependency>
            <groupId>com.klinec</groupId>
            <artifactId>jcardsim</artifactId>
            <version>${jcardsim.version}</version>
            <scope>compile</scope>
        </dependency>

        <!-- Java 11 has no JSON. Gson is used for request parsing and the
             state document only; nothing on the card path depends on it. -->
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>${gson.version}</version>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <!-- The shaded jar's name is fixed so CI and the app repos can refer
             to tools/cardsim/target/cardsim.jar without knowing the version. -->
        <finalName>cardsim</finalName>
        <plugins>
            <!--
                The applet sources are compiled in directly as a second source
                root. There is no root aggregator pom and nothing is installed
                into ~/.m2: applet/ stays byte-identical, so the CAP job's
                tracked-CAP diff is unaffected by anything under tools/cardsim.
                Moving applet/ breaks this path; the cardsim CI job catches it.
            -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>add-applet-source</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>add-source</goal>
                        </goals>
                        <configuration>
                            <sources>
                                <source>${project.basedir}/../../applet/src/main/java</source>
                            </sources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.12.1</version>
                <configuration>
                    <release>11</release>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
                <configuration>
                    <useModulePath>false</useModulePath>
                </configuration>
            </plugin>
            <!-- tools/cardsim/cardsim.sh: mvn compile exec:java -Dexec.args="..." -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.1.0</version>
                <configuration>
                    <mainClass>me.flashapp.cashu.cardsim.CardSim</mainClass>
                </configuration>
            </plugin>
            <!-- target/cardsim.jar: everything in one file, run with java -jar. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.1</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <!-- Signature entries from signed
                                             dependencies do not match a
                                             merged jar and make java -jar
                                             refuse to start. -->
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>me.flashapp.cashu.cardsim.CardSim</mainClass>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
